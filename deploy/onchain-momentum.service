[Unit]
Description=On-Chain Momentum Scanner & Telegram Bot Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/onchain-momentum-scanner
EnvironmentFile=/opt/onchain-momentum-scanner/.env
ExecStart=/opt/onchain-momentum-scanner/venv/bin/python -m src.main
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
