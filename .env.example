# =====================================================================
# ON-CHAIN MOMENTUM SCANNER CONFIGURATION
# =====================================================================

# Telegram Notification Settings
# Create a bot with @BotFather to get the token.
# Get your Chat ID with @userinfobot or invite bot to a channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM=true

# Execution Cadence
SCAN_INTERVAL_MINUTES=15
TOP_PICKS_PER_SCAN=3
ALERT_COOLDOWN_HOURS=12
TARGET_UNIVERSE_SIZE=3000

# Filtering Universe ($200k - $10M Sweet Spot)
MIN_MCAP_USD=200000
MAX_MCAP_USD=10000000
MIN_AGE_DAYS=2.5
MIN_LIQUIDITY_USD=20000
MIN_VOLUME_24H_USD=50000
MAX_FDV_MCAP_RATIO=1.75

# Momentum & Flow Thresholds
MIN_BUYER_RATIO_1H=0.45
MIN_PRICE_CHANGE_1H=-5.0
MIN_PRICE_CHANGE_6H=-5.0
MIN_PRICE_CHANGE_24H=5.0
MIN_MOMENTUM_SCORE=40.0

# Supported Chains (comma-separated: solana, base, ethereum, bsc, arbitrum)
ENABLED_CHAINS=solana,base,ethereum,bsc

# Storage
DATABASE_PATH=data/scanner.db
